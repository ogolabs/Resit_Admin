# -----------------------------------------------------------------------------
# Resit Admin — Environment Configuration Template
# Copy this file to .env.local and populate the values for your environment.
# -----------------------------------------------------------------------------
NODE_ENV=development
# Network Configuration ("testnet" or "mainnet")
NEXT_PUBLIC_NETWORK=testnet

# MongoDB Connection Strings
MONGODB_URI_TESTNET=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/resit_testnet?retryWrites=true&w=majority
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/resit?retryWrites=true&w=majority

# Administrative Authentication Gate
# 32+ character random secret for signing admin session JWTs
ADMIN_SESSION_SECRET=resit_admin_internal_secret_key_change_in_production_min_32_chars
# Comma-separated list of authorized administrator email addresses
ADMIN_EMAILS=admin@resit.co,ops@resit.co

# Internal Frontend URL (used by Admin to query relayer reconcile sweeps)
FRONTEND_INTERNAL_URL=http://localhost:3000

# Shared Cron & Relayer Secret (must match frontend CRON_SECRET)
CRON_SECRET=resit_cron_internal_secret_change_in_production

# Blockchain Infrastructure & Relayer
# Primary Electroneum relayer account address for balance and nonce telemetry
RELAYER_ADDRESS=0xED0fa5f6749b398DcD10A1E643cC0aBc3096bEa4
# Optional Ankr premium API key for enhanced RPC speed
ANKR_API_KEY=

# Email Dispatch via ZeptoMail (used to deliver Admin 6-digit OTP passcodes)
ZEPTOMAIL_SEND_TOKEN=Zoho-enczapikey-placeholder
ZEPTOMAIL_FROM_EMAIL=support@userecover.xyz
ZEPTOMAIL_FROM_NAME=Resit Mission Control
